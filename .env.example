# Database
DATABASE_URL="postgresql://username:password@localhost:5432/maintenance_db?schema=public"

# Application
PORT=8080

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Google OAuth
# Créer les identifiants sur https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:8080/auth/google/callback"

# Frontend (utilisé pour la redirection après connexion Google)
FRONTEND_URL="http://localhost:3000"
