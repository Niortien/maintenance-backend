// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TypeVehicule {
  CAMINON
  CAMIONNETTE
  VOITURE
  EQUIPEMENT
}

enum Statut {
  ACTIF
  EN_MAINTENANCE
  INACTIF
}

enum StatutIntervention {
  EN_ATTENTE
  EN_COURS
  TERMINEE
  ANNULEE
}

enum Specialite {
  MECANIQUE_GENERALE
  ELECTRICITE_AUTOMOBILE
  PNEUMATIQUE
  DIAGNOSTIC_ELECTRONIQUE
  SYSTEME_FREINAGE
  CLIMATISATION
  TRANSMISSION
  HYDRAULIQUE
  CARROSSERIE
  PEINTURE
}

enum Priorite {
  FAIBLE
  MOYENNE
  ELEVEE
  URGENTE
}

enum CategorieVehicule {
  TASSEUR
  BP
  AMPLIROLL
  TRACTEUR
  KIA
  VOITURETTE
  PC
  MOTO_TRICYCLE
  KB
}

enum StatutVehiculeRapport {
  OPERATIONNEL
  EN_PANNE
  ACCIDENTE
  EN_ATTENTE
}

enum TypePanne {
  MECANIQUE
  AIR
  ELECTRICITE
  SOUDURE
  HYDRAULIQUE
  PNEUMATIQUE
  POMPE_INJECTION
  PNEU
  CARROSSERIE
  AUTRE
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Vehicule {
  id               String         @id @default(ulid())
  nom              String
  numero_de_plaque String
  annee            Int
  type             TypeVehicule
  modele           String
  statut           Statut
  interventions    Intervention[]
  site             Site?          @relation(fields: [siteId], references: [id])
  siteId           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt @map("updated_at")
}

model Technicien {
  id                 String         @id @default(ulid())
  nom                String
  prenom             String
  email              String         @unique
  telephone          String
  statut             Statut         @default(ACTIF)
  specialite         Specialite
  interventions      Intervention[]
  site               Site?          @relation("TechnicienSite", fields: [siteId], references: [id])
  siteId             String?
  sitesResponsable   Site[]         @relation("ResponsableSite")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt @map("updated_at")
}

model Intervention {
  id          String   @id @default(ulid())
  date        DateTime
  description String
  situation   String
  designation String
  vehicule    Vehicule @relation(fields: [vehiculeId], references: [id])
  vehiculeId  String

  technicien   Technicien? @relation(fields: [technicienId], references: [id], onDelete: SetNull)
  technicienId String? // nullable pour éviter blocage

  priorite             Priorite           @default(MOYENNE)
  cout                 Float
  temps_estime_heures  Float
  temps_reel_heures    Float?
  pieces_utilisees     String?
  notes_additionnelles String?
  statut               StatutIntervention @default(EN_ATTENTE)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt @map("updated_at")
}

model Site {
  id              String              @id @default(ulid())
  nom             String
  code            String              @unique
  region          String?
  couleur         String?             // ex: "#10b981"
  responsable     Technicien?         @relation("ResponsableSite", fields: [responsableId], references: [id])
  responsableId   String?
  vehicules       Vehicule[]
  techniciens     Technicien[]        @relation("TechnicienSite")
  rapports        RapportJournalier[]
  compte          ResponsableSite?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt @map("updated_at")
}

model ResponsableSite {
  id        String   @id @default(ulid())
  email     String   @unique
  password  String
  nom       String
  prenom    String
  telephone String?
  site      Site     @relation(fields: [siteId], references: [id])
  siteId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @map("updated_at")
}

model RapportJournalier {
  id        String         @id @default(ulid())
  date      DateTime
  site      Site           @relation(fields: [siteId], references: [id])
  siteId    String
  lignes    LigneRapport[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt @map("updated_at")
}

model LigneRapport {
  id              String                @id @default(ulid())
  rapport         RapportJournalier     @relation(fields: [rapportId], references: [id], onDelete: Cascade)
  rapportId       String
  codeVehicule    String
  immatriculation String?
  categorie       CategorieVehicule
  statut          StatutVehiculeRapport
  typesPannes     TypePanne[]
  description     String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt @map("updated_at")
}
